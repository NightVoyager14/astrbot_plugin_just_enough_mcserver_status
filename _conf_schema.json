          "isEnabled": {
            "description": "标题显示",
            "hint": "是否开启服务器标题在信息卡片中渲染",
            "type": "bool",
            "default": true
          }
        }
      },
      "motd": {
        "description": "MOTD",
        "type": "object",
        "hint": "服务器MOTD相关配置",
        "items": {
          "isEnabled": {
            "description": "MOTD显示",
            "hint": "是否开启服务器MOTD在信息卡片中渲染",
            "type": "bool",
            "default": true
          }
        }
      },
      "player_count": {
        "description": "在线人数",
        "type": "object",
        "hint": "服务器在线人数相关配置",
