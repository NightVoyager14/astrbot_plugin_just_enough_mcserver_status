              },
              "medium": {
                "description": "Medium",
                "type": "int",
                "hint": "延迟一般",
                "default": 200
              },
              "bad": {
                "description": "Bad",
                "type": "int",
                "hint": "延迟较差",
                "default": 500
              }
            }
          }
        }
      },
      "icon": {
        "description": "图标",
        "type": "object",
        "hint": "服务器图标相关配置",
        "items": {
          "isEnabled": {
            "description": "服务器图标显示",
            "hint": "是否开启服务器图标在信息卡片中渲染",
            "type": "bool",
            "default": true
          }
        }
      },
      "title": {
        "description": "标题",
        "type": "object",
        "hint": "服务器标题相关配置",
