{
  "general": {
    "description": "通用",
    "type": "object",
    "hint": "插件通用配置",
    "items": {
      "is_info_card_enabled": {
        "description": "信息卡片渲染",
        "type": "bool",
        "hint": "是否开启信息卡片的渲染",
        "default": true
      },
      "is_info_text_enabled": {
        "description": "文字信息输出",
        "type": "bool",
        "hint": "是否开启文字信息的输出",
        "default": true
      }
    }
  },
  "quick_ping": {
    "description": "快捷查询",
    "hint": "快捷查询指令（/jeping quick）相关配置",
    "type": "object",
    "items": {
      "servers": {
        "description": "预设服务器",
        "type": "template_list",
        "hint": "快捷查询服务器预设",
        "templates": {
          "server": {
            "name": "预设服务器模板",
            "hint": "快捷查询服务器预设模板",
            "display_item": "quick_name",
            "hide_hint_in_list": true,
            "items": {
              "quick_name": {
                "description": "快捷查询名称",
                "hint": "在快捷查询时使用的服务器名称",
                "type": "string",
                "default": "server"
              },
              "is_default": {
                "description": "默认查询",
                "hint": "是否将该预设服务器作为快捷查询的默认服务器",
                "type": "bool",
                "default": false
              },
              "is_bedrock": {
                "description": "基岩版",
                "hint": "是否以基岩版的方式查询",
                "type": "bool",
                "default": false
              },
              "address": {
                "description": "服务器地址",
                "hint": "同status指令中一样，格式为 <服务器地址[:服务器端口]>",
                "type": "string"
              },
              "display_name": {
                "description": "展示服务器名称",
                "type": "string",
                "hint": "设置在信息卡片中和文字信息输出中展示的服务器名称，如果不填写为空，则显示为SRV解析地址"
              }
            }
          }
        }
      }
    }
  },
  "text_info": {
    "description": "文字信息",
    "type": "object",
    "hint": "聊天文字信息相关配置",
    "items": {
      "is_markdown_enabled": {
        "description": "Markdown格式输出",
        "type": "bool",
        "hint": "是否启用Markdown格式以美化文字信息输出（注：如果平台不支持Markdown渲染，可以关闭此项）",
        "default": true
      }
    }
  },
  "info_card": {
    "description": "信息卡片",
    "type": "object",
    "hint": "信息卡片相关内容配置",
    "items": {
      "ping_indicator": {
        "description": "延迟指示器",
        "type": "object",
        "hint": "延迟展示器的相关配置",
        "items": {
          "is_enabled": {
            "description": "延迟指示器显示",
            "hint": "是否开启延迟指示器在信息卡片中渲染",
            "type": "bool",
            "default": true
          },
          "ping_thresholds": {
            "description": "阈值",
            "type": "object",
            "hint": "延迟指示器阈值设置（ms）",
            "items": {
              "excellent": {
                "description": "Excellent",
                "type": "int",
                "hint": "延迟优秀",
                "default": 50
              },
              "good": {
                "description": "Good",
                "type": "int",
                "hint": "延迟较好",
                "default": 100
              },
              "medium": {
                "description": "Medium",
                "type": "int",
                "hint": "延迟一般",
                "default": 200
              },
              "bad": {
                "description": "Bad",
                "type": "int",
                "hint": "延迟较差",
                "default": 500
              }
            }
          }
        }
      },
      "icon": {
        "description": "图标",
        "type": "object",
        "hint": "服务器图标相关配置",
        "items": {
          "is_enabled": {
            "description": "服务器图标显示",
            "hint": "是否开启服务器图标在信息卡片中渲染",
            "type": "bool",
            "default": true
          }
        }
      },
      "title": {
        "description": "标题",
        "type": "object",
        "hint": "服务器标题相关配置",
        "items": {
          "is_enabled": {
            "description": "标题显示",
            "hint": "是否开启服务器标题在信息卡片中渲染",
            "type": "bool",
            "default": true
          }
        }
      },
      "motd": {
        "description": "MOTD",
        "type": "object",
        "hint": "服务器MOTD相关配置",
        "items": {
          "is_enabled": {
            "description": "MOTD显示",
            "hint": "是否开启服务器MOTD在信息卡片中渲染",
            "type": "bool",
            "default": true
          },
          "leading": {
            "description": "行间距",
            "hint": "MOTD渲染行间距（单位：px）",
            "type": "int",
            "default": 10
          }
        }
      },
      "player_count": {
        "description": "在线人数",
        "type": "object",
        "hint": "服务器在线人数相关配置",
        "items": {
          "is_enabled": {
            "description": "在线人数显示",
            "hint": "是否开启服务器在线人数在信息卡片中渲染",
            "type": "bool",
            "default": true
          }
        }
      },
      "background": {
        "description": "背景",
        "type": "object",
        "hint": "信息卡片背景相关配置",
        "items": {
          "is_custom_enabled": {
            "description": "自定义背景",
            "hint": "是否启用自定义的背景，若关闭则自动使用默认背景",
            "type": "bool",
            "default": false
          },
          "upload": {
            "description": "上传背景图片",
            "type": "file",
            "hint": "请上传一张格式为PNG格式的图片（大小：1248 × 144，如果不是插件会自行拉伸），若上传多张每次渲染会随机选用一张",
            "default": [],
            "file_types": [
              "png"
            ]
          }
        }
      }
    }
  }
}