{
  "general": {
    "description": "通用",
    "type": "object",
    "hint": "插件通用配置",
    "items": {
      "isInfoCardEnabled": {
        "description": "信息卡片渲染",
        "type": "bool",
        "hint": "是否开启信息卡片的渲染",
        "default": true
      },
      "isInfoTextEnabled": {
        "description": "文字信息输出",
        "type": "bool",
        "hint": "是否开启文字信息的输出",
        "default": true
      }
    }
  },
